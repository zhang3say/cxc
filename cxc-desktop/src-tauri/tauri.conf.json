{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CXC",
  "version": "0.2.1",
  "identifier": "com.cxc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CXC",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 500,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
